<Window x:Class="Pomodoro.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pomodoro"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="LightPink" Offset="0"/>
            <GradientStop Color="LightBlue" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="Pomodoro"
                    FontSize="30"
                   FontFamily="Corbel"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Foreground="white"
                   Grid.Row="0"
                   Margin="20"
                   Grid.ColumnSpan="3"
                   Grid.Column="1"/>
        
        <Button x:Name="StartBtn"
            Content="СТАРТ"
                Grid.Column="1"
                Grid.Row="2"
                FontSize="20px"
                FontFamily="Corbel"
                Background="LightBlue"
                Click="StartBtn_Click"/>
        
        <Button x:Name="PauseBtn"
            Content="ПАУЗА"
         Grid.Column="2"
         Grid.Row="2"
         FontSize="20px"
         FontFamily="Corbel"
                IsEnabled="false"
                Click="PauseBtn_Click"
         Background="White"/>
        
        <Button x:Name="ResetBtn"
            Content="СБРОСИТЬ"
         Grid.Column="3"
         Grid.Row="2"
         FontSize="20px"
         FontFamily="Corbel"
         Background="LightCoral"
                Click="ResetBtn_Click"/>
        
        <TextBlock x:Name="TimerDisplay" 
            Text="Осталось времени:"
                   FontFamily="Corbel"
                   Grid.Column="1"
                   Grid.Row="1"
                   Margin="20"
                   Foreground="white"
                   FontSize="25"
                   Grid.ColumnSpan="2"
               />
        <WrapPanel Grid.Row="3"
           Grid.Column="1"
           Grid.ColumnSpan="3"
           Margin="10"
          Background="White">
           

            <RadioButton x:Name="work20min"
                 GroupName="WorkTime"
                 Content="20 минут"
                 Checked="WorkTimeCheck"
                 IsChecked="True"
                 Margin="10,5"
                 VerticalAlignment="Center"/>


            <RadioButton x:Name="work25min" 
                GroupName="WorkTime"
                 Content="25 минут"
                Checked="WorkTimeCheck"
                 Margin="10,5" />
            <RadioButton x:Name="work30min"
                 GroupName="WorkTime"
                 Content="30 минут"
                 Checked="WorkTimeCheck"
                 Margin="10,5" />

             <RadioButton x:Name="work45min" 
                 GroupName="WorkTime"
                 Content="45 минут"
                 Checked="WorkTimeCheck"
                 Margin="10,5" />

            <RadioButton x:Name="work60min"
                 GroupName="WorkTime"
                 Content="60 минут"
                 Checked="WorkTimeCheck"
                 Margin="10,5" />
            <RadioButton  x:Name="work25sec"
                 GroupName="WorkTime"
                 Content="25 сек"
                 Checked="WorkTimeCheck"
                 Margin="10,5"
                />
        </WrapPanel>

    </Grid>
</Window>
